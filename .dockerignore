.DS_Store

# Secrets are injected at runtime via compose env_file, never baked into a layer.
.env
.env.local

# Dev-only tooling that the production image never runs.
#
# `scripts` is deliberately NOT excluded: src/lib/caption-search.ts imports
# scripts/lib/subtitle-terminology, which in turn loads its .json glossary, so
# the build needs both in context. Only .next/standalone is copied into the
# runtime image, so nothing here reaches the final layer regardless.
drizzle
drizzle.config.ts
**/*.test.ts
vitest.config.ts

Dockerfile
.dockerignore
compose.yaml
README.md
