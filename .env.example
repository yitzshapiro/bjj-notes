# Neon Postgres connection string (use the pooled/serverless connection string).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Google Cloud OAuth 2.0 Web application credentials.
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# The only Google account permitted to sign in (case-insensitive).
ALLOWED_GOOGLE_EMAIL=you@example.com

# The ID of the one Google Drive folder that becomes the library root.
DRIVE_ROOT_FOLDER_ID=replace-with-google-drive-folder-id

# Optional: subtitle generation through Deepgram Nova-3.
DEEPGRAM_API_KEY=
# Usually supplied by `pnpm subtitles:auth` instead of setting this manually.
GOOGLE_REFRESH_TOKEN=
